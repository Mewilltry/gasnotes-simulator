FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim
ENV SIM_ROOM_STORE=/sim_rooms
RUN mkdir -p /sim_rooms

RUN apt-get update \
 && apt-get install -y --no-install-recommends nodejs npm curl \
 && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci || echo "npm ci failed, continuing"
RUN npm install -g esbuild@0.25.0 \
 && mkdir -p /simulator/node_modules/.bin \
 && ln -sf "$(which esbuild)" /simulator/node_modules/.bin/esbuild \
 && /simulator/node_modules/.bin/esbuild --version

COPY uv.lock pyproject.toml .python-version .
RUN uv sync --frozen

COPY app /simulator/app
RUN mkdir -p /simulator/sim_rooms

ENV PYTHONPATH=/simulator
CMD mkdir -p /sim_rooms && \
    uv run --no-sync gunicorn --chdir /simulator \
    -b 0.0.0.0:${PORT:-8069} \
    --worker-class gevent -w 1 app.wsgi:app

